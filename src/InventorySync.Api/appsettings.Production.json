{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Erp": {
    "BaseUrl": "http://mock-erp:8080"
  },
  "Sync": {
    "PageSize": 500,
    "ConflictResolution": "NewerWins"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  }
}
